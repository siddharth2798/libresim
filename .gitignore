# ---- Godot (project is in game/) ----
# Import cache and editor state: regenerated by `./run.sh` / `godot --headless --path game --import`.
game/.godot/
game/.import/
game/override.cfg
export_credentials.cfg
game/export_credentials.cfg
# NOTE: *.import and *.uid files are NOT ignored. They hold import settings (texture mipmaps,
# audio loops) and resource UIDs, and Godot's docs say to commit them.

# ---- downloaded and generated game data (run.sh builds it; see docs/USAGE.md) ----
data/

# ---- build and release output (tools/package/make_release.sh, flatpak, exports) ----
build/
dist/
*.pck
*.apk
*.aab
*.AppImage
*.dmg
*.flatpak
.flatpak-builder/

# ---- player output ----
recordings/

# ---- Python tooling ----
tools/.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
gdalwmscache/

# ---- editors, OS, logs ----
.vscode/
.idea/
*.swp
*~
