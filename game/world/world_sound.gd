class_name WorldSound
extends RefCounted
## Sounds of things around the aircraft (airport vehicles, jetways, thunder): positional players and the pure mapping
## from a vehicle's speed to its engine's volume and pitch (tests/test_world_sound.gd). Files are in world/sounds/
## (generated by tools/29_generated_sounds.py, see SOURCES.md); a missing file is silent. Bus "Environment".
## docs/AUDIO-PLAN.md.

const DIR := "res://world/sounds/"
const COCKPIT_HZ := 2000.0  # heard through the airframe from the cockpit
const OPEN_HZ := 9000.0

## kind -> engine sound: file, idle (volume, pitch at rest), full (at full_mps), unit_m (full volume within), moving
## (false: a stationary machine that runs while it works: GPU, fuel pump).
const KINDS := {
	"pushback_tug": {"file": "diesel_loop.wav", "idle": [0.55, 0.85], "full": [1.0, 1.45], "full_mps": 3.0, "unit_m": 10.0},
	"baggage_tug": {"file": "diesel_loop.wav", "idle": [0.35, 1.05], "full": [0.7, 1.6], "full_mps": 6.0, "unit_m": 6.0},
	"apron_bus": {"file": "diesel_loop.wav", "idle": [0.4, 0.75], "full": [0.8, 1.2], "full_mps": 8.0, "unit_m": 8.0},
	"fire_truck": {"file": "diesel_loop.wav", "idle": [0.45, 0.7], "full": [0.9, 1.25], "full_mps": 10.0, "unit_m": 10.0},
	"gpu": {"file": "diesel_loop.wav", "idle": [0.5, 1.3], "full": [0.5, 1.3], "full_mps": 1.0, "unit_m": 8.0, "moving": false},
	"fuel_truck": {"file": "res://aircraft/a320/sounds/hyd_pump_loop.wav", "idle": [0.3, 0.7], "full": [0.3, 0.7], "full_mps": 1.0,
		"unit_m": 5.0, "moving": false},
	"hydrant_dispenser": {"file": "res://aircraft/a320/sounds/hyd_pump_loop.wav", "idle": [0.3, 0.75], "full": [0.3, 0.75],
		"full_mps": 1.0, "unit_m": 5.0, "moving": false},
	"follow_me": {"file": "car_loop.wav", "idle": [0.35, 0.9], "full": [0.8, 2.0], "full_mps": 12.0, "unit_m": 6.0},
}


static func path(file: String) -> String:
	return file if file.begins_with("res://") else DIR + file


## [volume (linear), pitch] of a vehicle of this kind moving at speed_mps (either direction); [0, 1] for an unknown kind.
static func vehicle_state(kind: String, speed_mps: float) -> Array:
	var k: Dictionary = KINDS.get(kind, {})
	if k.is_empty():
		return [0.0, 1.0]
	var u := clampf(absf(speed_mps) / float(k.full_mps), 0.0, 1.0)
	return [lerpf(k.idle[0], k.full[0], u), lerpf(k.idle[1], k.full[1], u)]


## A looping positional player for `file` (inverse-distance fall-off from unit_m, inaudible past max_m). Not playing yet.
static func loop_player(file: String, unit_m: float, max_m := 800.0) -> AudioStreamPlayer3D:
	AudioSettings.ensure_buses()
	var p := AudioStreamPlayer3D.new()
	var f := path(file)
	var s: AudioStreamWAV = load(f) if ResourceLoader.exists(f) else null
	if s:
		s = s.duplicate()
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = int(s.get_length() * s.mix_rate)
	p.stream = s
	p.bus = "Environment"
	p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	p.unit_size = unit_m
	p.max_distance = max_m
	p.max_db = 0.0
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_IDLE_STEP
	return p


static func cockpit_view() -> bool:
	return str(Props.get_v("view/mode", "Chase")) == "Cockpit"


## Cut-off for a world sound heard now: the cabin takes the high end off in the cockpit view.
static func cutoff_hz() -> float:
	return COCKPIT_HZ if cockpit_view() else OPEN_HZ
