{
 "doc": "The A320 FCU truth table (docs/A320-FCU-REFERENCE.md): tests/test_fcu_truth_table.gd runs it. modes: AfLogic scenarios (aircraft at alt_ft, 130 kt CAS, thrust levers at lever; each step sets FCU values or a push / pull 'select', runs n ticks of 0.1 s, then checks). colors: AfFma.color. windows: FcuWindows from props.",
 "modes": [
  {"id": "ALT turned while holding ALT: the mode stays and the aircraft keeps the memorised altitude (level: no climb command)", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3, "expect": {"vert": "ALT"}}, {"f": {"fcu_alt_ft": 12000}, "n": 5, "expect": {"vert": "ALT", "level": true}}]},
  {"id": "ALT pulled: open climb, ALT armed", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"fcu_alt_ft": 12000}, "n": 3, "expect": {"vert": "ALT"}}, {"select": "OPEN", "n": 3, "expect": {"vert": "OP CLB", "armed_vert": ["ALT"], "vs_mgd": false}}]},
  {"id": "ALT pushed: managed climb", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"fcu_alt_ft": 12000, "vs_mgd": true}, "select": "MANAGED", "n": 3, "expect": {"vert": "CLB", "armed_vert": ["ALT"]}}]},
  {"id": "ALT turned the wrong way in OP CLB reverts to V/S at the present rate", "base": {"alt_ft": 10000, "fcu_alt_ft": 12000, "vs_fpm": 0},
   "steps": [{"n": 2}, {"select": "OPEN", "n": 3, "expect": {"vert": "OP CLB"}}, {"f": {"fcu_alt_ft": 8000}, "n": 3, "expect": {"vert": "V/S", "writes": ["vs"]}}]},
  {"id": "ALT turned the wrong way in a managed climb reverts to V/S and drops the managed dot", "base": {"alt_ft": 10000, "fcu_alt_ft": 12000, "vs_mgd": true},
   "steps": [{"n": 3, "expect": {"vert": "CLB"}}, {"f": {"fcu_alt_ft": 8000}, "n": 1, "expect": {"vert": "V/S", "writes": ["vs", "vs_mgd"], "vs_mgd": false}}]},
  {"id": "V/S pulled with dashes: V/S at the present vertical speed", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"select": "VS", "n": 2, "expect": {"vert": "V/S", "writes": ["vs"]}}]},
  {"id": "V/S pushed: level off, V/S 0", "base": {"alt_ft": 10000, "fcu_alt_ft": 14000, "vs_fpm": 1500},
   "steps": [{"select": "VS", "n": 3, "expect": {"vert": "V/S"}}, {"select": "LEVEL", "n": 2, "expect": {"vert": "V/S", "writes": ["vs"], "vs": 0}}]},
  {"id": "HDG pushed without a route: NAV refused, the request is withdrawn", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"hdg_mgd": true}, "n": 2, "expect": {"lat": "HDG", "writes": ["hdg_mgd"], "hdg_mgd": false}}]},
  {"id": "HDG pushed with a route: NAV", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "gps": true},
   "steps": [{"n": 3}, {"f": {"hdg_mgd": true}, "n": 2, "expect": {"lat": "NAV", "hdg_mgd": true}}]},
  {"id": "LOC pressed without a signal: LOC armed on line 2 of the lateral column", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"loc": true}, "n": 2, "expect": {"lat": "HDG", "armed_lat": "LOC", "fma_lat": "HDG\nLOC"}}]},
  {"id": "APPR pressed: LOC and G/S armed", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"appr": true}, "n": 2, "expect": {"armed_lat": "LOC", "armed_vert": ["G/S"]}}]},
  {"id": "LOC pressed again disarms", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000},
   "steps": [{"n": 3}, {"f": {"loc": true}, "n": 2, "expect": {"armed_lat": "LOC"}}, {"f": {"loc": false}, "n": 2, "expect": {"armed_lat": ""}}]},
  {"id": "A/THR pressed with the levers in CLIMB: active (SPEED), A/THR in column 5", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "lever": 0.556},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"athr_armed": true, "athr_active": true, "fma_thrust": "SPEED", "fma_misc": "AP1\n1FD2\nA/THR"}}]},
  {"id": "A/THR pressed with the levers above CLIMB in the cruise: armed only, MAN THR (LVR CLB is only for a takeoff or go-around)", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "lever": 0.7},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"athr_armed": true, "athr_active": false, "fma_thrust": "MAN\nTHR"}}]},
  {"id": "A/THR pressed again: off", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "lever": 0.556},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"athr_armed": true}}, {"f": {"athr": false}, "n": 2, "expect": {"athr_armed": false, "athr_active": false}}]},
  {"id": "A/THR with the levers at idle in flight: refused, the light springs back", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "lever": 0.0},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"athr_armed": false, "athr_active": false, "fma_thrust": ""}}]},
  {"id": "Levers to idle in flight disconnect an active A/THR", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "lever": 0.556},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"athr_active": true}}, {"f": {"lever": 0.0}, "n": 3, "expect": {"athr_armed": false, "athr_active": false}}]},
  {"id": "Takeoff: levers to TOGA on the ground arm A/THR (white MAN TOGA, A/THR in column 5), it is not active", "base": {"wow": true, "lever": 0.0},
   "steps": [{"n": 3, "expect": {"athr_armed": false}}, {"f": {"lever": 1.0}, "n": 3, "expect": {"athr_armed": true, "athr_active": false, "fma_thrust": "MAN\nTOGA", "fma_misc": "\n1FD2\nA/THR"}}]},
  {"id": "Takeoff: FLX/MCT with a flex temperature arms A/THR (MAN FLX 50)", "base": {"wow": true, "lever": 0.0, "flex_c": 50},
   "steps": [{"f": {"lever": 0.778}, "n": 3, "expect": {"athr_armed": true, "athr_active": false, "fma_thrust": "MAN\nFLX 50"}}]},
  {"id": "Takeoff: FLX/MCT without a flex temperature is MCT and does not arm A/THR", "base": {"wow": true, "lever": 0.0},
   "steps": [{"f": {"lever": 0.778}, "n": 3, "expect": {"athr_armed": false, "fma_thrust": "MAN\nMCT"}}]},
  {"id": "Takeoff with the flight director off: TOGA does not arm A/THR", "base": {"wow": true, "lever": 0.0, "fd": false},
   "steps": [{"f": {"lever": 1.0}, "n": 3, "expect": {"athr_armed": false}}]},
  {"id": "After takeoff, TOGA above the reduction altitude: LVR CLB, then the CL detent makes A/THR active", "base": {"wow": true, "lever": 0.0},
   "steps": [{"f": {"lever": 1.0}, "n": 3, "expect": {"athr_armed": true}}, {"f": {"wow": false, "ra_ft": 2500, "alt_ft": 2500}, "n": 3, "expect": {"athr_armed": true, "athr_active": false, "fma_thrust": "LVR CLB"}},
    {"f": {"lever": 0.556}, "n": 3, "expect": {"athr_armed": true, "athr_active": true}}]},
  {"id": "SPD/MACH: SPEED in the A/THR column with knots, MACH with the Mach window", "base": {"alt_ft": 25000, "fcu_alt_ft": 25000, "lever": 0.556, "pressure_pa": 37600},
   "steps": [{"f": {"athr": true}, "n": 3, "expect": {"fma_thrust": "SPEED"}}, {"f": {"spd_mach": true, "mach_sel": 0.7}, "n": 3, "expect": {"fma_thrust": "MACH"}}, {"f": {"spd_mach": false}, "n": 3, "expect": {"fma_thrust": "SPEED"}}]},
  {"id": "SPD/MACH pressed while managed is not a turned value (no 10 s preview)", "base": {"alt_ft": 10000, "fcu_alt_ft": 10000, "spd_mgd": true},
   "steps": [{"n": 3}, {"f": {"spd_mach": true}, "n": 3, "expect": {"spd_preview": false}}, {"f": {"mach_sel": 0.72}, "n": 2, "expect": {"spd_preview": true}}]},
  {"id": "Autoland: both APs, ILS, CONF FULL: LAND below 400 ft, FLARE below 40 ft, THR IDLE from 30 ft, RETARD from 10 ft, ROLL OUT at touchdown (ILS rows: course 0, 3 deg path, aircraft on it)", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"f": {"athr": true}, "n": 20, "expect": {"vert": "G/S", "lat": "LOC", "fma_vert": "G/S", "fma_appr": "CAT3 DUAL", "land": "", "ap1": true, "ap2": true}},
    {"f": {"ra_ft": 390}, "n": 3, "expect": {"land": "LAND", "fma_vert": "LAND", "fma_lat": "LOC", "fma_appr": "CAT3 DUAL"}},
    {"f": {"ra_ft": 35}, "n": 3, "expect": {"land": "FLARE", "fma_vert": "FLARE", "fma_lat": "LOC"}},
    {"f": {"ra_ft": 25}, "n": 3, "expect": {"fma_thrust": "THR IDLE"}},
    {"f": {"ra_ft": 8}, "n": 3, "expect": {"fma_thrust": "RETARD", "land": "FLARE"}},
    {"f": {"wow": true, "ra_ft": 0}, "n": 3, "expect": {"land": "ROLLOUT", "fma_lat": "ROLL OUT", "fma_vert": "", "fma_thrust": "RETARD", "athr_active": true, "ap1": true, "ap2": true}},
    {"f": {"gs_mps": 8}, "n": 3, "expect": {"land": "", "ap1": false, "ap2": false, "disc": 0}}]},
  {"id": "Autoland: one AP only: no LAND, CAT1, the AP disconnects at 50 ft with the warning", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S", "lat": "LOC", "fma_appr": "CAT1", "land": "", "ap1": true, "ap2": false}},
    {"f": {"ra_ft": 390}, "n": 3, "expect": {"land": "", "fma_vert": "G/S", "fma_appr": "CAT1", "ap1": true}},
    {"f": {"ra_ft": 45}, "n": 2, "expect": {"ap1": false, "disc": 1, "warning": true}}]},
  {"id": "Autoland: CONF 2 is not a landing configuration (CAT1, no LAND)", "base": {"ils": true, "ra_ft": 600, "flap_lever": 3, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S", "fma_appr": "CAT1"}}, {"f": {"ra_ft": 390}, "n": 3, "expect": {"land": "", "fma_vert": "G/S"}}]},
  {"id": "Autoland: TOGA in LAND is a go-around (SRS), the autoland ends", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 300}, "n": 3, "expect": {"land": "LAND"}}, {"f": {"lever": 1.0}, "n": 3, "expect": {"vert": "SRS", "land": "", "ap1": true}}]},
  {"id": "Autoland: the localizer lost in LAND above 15 ft disconnects the AP with the warning", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 300}, "n": 3, "expect": {"land": "LAND"}}, {"f": {"ils_off": true}, "n": 3, "expect": {"land": "", "ap1": false, "ap2": false, "warning": true, "disc": 1}}]},
  {"id": "Autoland: the glide slope lost above 100 ft disconnects, below 100 ft the autoland flies on", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 300}, "n": 3, "expect": {"land": "LAND"}}, {"f": {"gs_valid": false}, "n": 3, "expect": {"land": "", "ap1": false, "warning": true, "disc": 1}}]},
  {"id": "Autoland: the glide slope lost at 90 ft: LAND goes on, then FLARE", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 300}, "n": 3, "expect": {"land": "LAND"}}, {"f": {"ra_ft": 90, "gs_valid": false}, "n": 3, "expect": {"land": "LAND", "ap1": true, "disc": 0}}, {"f": {"ra_ft": 35}, "n": 3, "expect": {"land": "FLARE", "fma_vert": "FLARE", "ap1": true}}]},
  {"id": "Autoland: APPR pressed off below 400 ft does not cancel LAND", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "ap2": true, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 300}, "n": 3, "expect": {"land": "LAND"}}, {"f": {"appr": false}, "n": 3, "expect": {"land": "LAND", "fma_vert": "LAND", "ap1": true}}]},
  {"id": "Autoland: touchdown with one AP: it drops quietly as before, no ROLL OUT", "base": {"ils": true, "ra_ft": 600, "flap_lever": 5, "appr": true},
   "steps": [{"n": 20, "expect": {"vert": "G/S"}}, {"f": {"ra_ft": 60}, "n": 2, "expect": {"ap1": true}}, {"f": {"wow": true, "ra_ft": 0}, "n": 3, "expect": {"land": "", "ap1": false, "fma_lat": "\nRWY"}}]}
 ],
 "colors": [
  {"col": "vertical", "text": "OP CLB\nALT", "line": 0, "expect": "green"},
  {"col": "vertical", "text": "OP CLB\nALT", "line": 1, "expect": "cyan"},
  {"col": "lateral", "text": "HDG\nLOC", "line": 1, "expect": "cyan"},
  {"col": "lateral", "text": "LOC*", "line": 0, "expect": "green"},
  {"col": "thrust", "text": "SPEED", "line": 0, "expect": "green"},
  {"col": "thrust", "text": "THR CLB", "line": 0, "expect": "green"},
  {"col": "thrust", "text": "MAN\nTOGA", "line": 0, "expect": "white"},
  {"col": "thrust", "text": "MAN\nTOGA", "line": 1, "expect": "white"},
  {"col": "thrust", "text": "MAN\nTHR", "line": 1, "expect": "white"},
  {"col": "thrust", "text": "LVR CLB", "line": 0, "expect": "white"},
