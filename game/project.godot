; Engine configuration file.
config_version=5

[application]
config/name="free-sim"
run/main_scene="res://ui/menu/start_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
FloatingOrigin="*res://core/floating_origin.gd"
Props="*res://core/props.gd"
Graphics="*res://core/graphics_settings.gd"
Session="*res://core/session.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=120

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/compress_with_gpu=false
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

haze_density={
"type": "float",
"value": 1.8e-05
}
fog_color={
"type": "color",
"value": Color(0.7, 0.78, 0.88, 1)
}
pattern_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
sky_top_color={
"type": "color",
"value": Color(0.32, 0.5, 0.78, 1)
}
