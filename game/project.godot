; Engine configuration file.
config_version=5

[application]
config/name="libresim"
run/main_scene="res://ui/menu/start_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://branding/icon.png"
boot_splash/bg_color=Color(0.024, 0.031, 0.094, 1)
boot_splash/image="res://branding/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]
FloatingOrigin="*res://core/floating_origin.gd"
Props="*res://core/props.gd"
Graphics="*res://core/graphics_settings.gd"
Session="*res://core/session.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=120

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/compress_with_gpu=false
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

haze_density={
"type": "float",
"value": 1.8e-05
}
fog_color={
"type": "color",
"value": Color(0.7, 0.78, 0.88, 1)
}
terrain_eye={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
pattern_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
sky_top_color={
"type": "color",
"value": Color(0.32, 0.5, 0.78, 1)
}
precip={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
rain_airspeed={
"type": "float",
"value": 0.0
}
