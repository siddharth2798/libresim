{
  "_doc": "Instrument panel layout (ui/instrument_panel.gd). cell / pad / switch_h are px at natural size; gauges sit on a cols x rows grid of cell-sized squares; radios is a column radio_w cells wide right of the grid, switches a row of switch_h along the bottom, strip an item spanning span cells. Every entry: script (ui/gauges/*.gd) + cell [col,row] + meta (set_meta on the gauge). overlay: the pieces of each 2D layout shown in outside views (panel_overlay.gd; items missing from this panel are skipped, no entry = no panel there). Where each item is in the 3D cockpit: aircraft.json cockpit.spots.",
  "cell": 190,
  "pad": 12,
  "switch_h": 70,
  "radio_w": 2.0,
  "cols": 4,
  "rows": 3,
  "gauges": {
    "asi": {"script": "res://ui/gauges/asi_gauge.gd", "cell": [0, 0]},
    "ai": {"script": "res://ui/gauges/attitude_gauge.gd", "cell": [1, 0]},
    "alt": {"script": "res://ui/gauges/altimeter_gauge.gd", "cell": [2, 0]},
    "vor1": {"script": "res://ui/gauges/cdi_gauge.gd", "cell": [3, 0], "meta": {"nav": 1, "gs": false}},
    "tc": {"script": "res://ui/gauges/turn_coordinator_gauge.gd", "cell": [0, 1]},
    "hi": {"script": "res://ui/gauges/heading_gauge.gd", "cell": [1, 1]},
    "vsi": {"script": "res://ui/gauges/vsi_gauge.gd", "cell": [2, 1]},
    "vor2": {"script": "res://ui/gauges/cdi_gauge.gd", "cell": [3, 1], "meta": {"nav": 2, "gs": true}},
    "tach": {"script": "res://ui/gauges/tach_gauge.gd", "cell": [0, 2]},
    "adf": {"script": "res://ui/gauges/adf_gauge.gd", "cell": [3, 2]}
  },
  "strip": {"script": "res://ui/gauges/engine_strip.gd", "cell": [1, 2], "span": [2, 1]},
