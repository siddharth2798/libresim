  "overlay": {
    "Full": [{"items": ["asi", "ai", "alt", "vor1", "tc", "hi", "vsi", "vor2", "tach", "strip", "adf", "radios", "switches"], "anchor": "bc", "height": 0.42}],
    "Split": [{"items": ["asi", "ai", "alt", "tc", "hi", "vsi"], "anchor": "bl", "height": 0.30}, {"items": ["vor1", "vor2", "adf"], "anchor": "br", "height": 0.42}, {"items": ["radios"], "anchor": "tr", "height": 0.40}],
    "Compact": [{"items": ["asi", "ai", "alt", "tc", "hi", "vsi"], "anchor": "bl", "height": 0.22}],
    "Minimal": [{"items": ["asi", "ai", "alt"], "anchor": "tr", "height": 0.12}]
  }
